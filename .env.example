# ===== DATABASE =====
# PostgreSQL connection string
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DB?sslmode=require

# ===== TELEGRAM =====
# Telegram Bot Token from BotFather
BOT_TOKEN=your_bot_token_here

# Admin Telegram ID for receiving notifications
ADMIN_TELEGRAM_ID=123456789

# Admin Chat ID
ADMIN_CHAT_ID=123456789

# Admin Secret for dashboard access
ADMIN_SECRET=your_secure_random_secret_here

# ===== SECURITY =====
# JWT Secret for cookie-based sessions (optional - only needed if OAUTH is used)
# NOTE: This app primarily uses Telegram WebApp auth, not cookies
# If OAUTH_SERVER_URL is not set, cookie auth is disabled
JWT_SECRET=your_jwt_secret_here

# OAuth Server URL - only needed for Manus OAuth integration
# If not set, cookie-based session auth will be disabled (expected for Telegram WebApp only)
# OAUTH_SERVER_URL=https://your-oauth-server.com

# ===== FRONTEND =====
FRONTEND_URL=https://your-app.onrender.com
WEBAPP_URL=https://your-app.onrender.com

# ===== ENVIRONMENT =====
NODE_ENV=production

# ===== SETTINGS =====
AD_REWARD=10
MIN_WITHDRAW=10000
STARS_RATE=1000
AD_COOLDOWN=30
